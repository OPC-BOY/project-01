                firstaid_en: "In case of frostbite from rapid gas release: Flush affected area with lukewarm water. Do NOT rub affected area.",
                ppe_ar: "قفازات واقية صناعية، نظارات سلامة لحماية العيون، أحذية سلامة بمقدمة صلبة.",
                ppe_en: "Industrial protective work gloves, safety glasses with side shields, steel-toe boots.",
                spill_ar: "في حالة التسرب: تهوية المكان جيداً. نقل الأسطوانات التالفة أو المسربة إلى مكان مفتوح إذا أمكن ذلك بأمان."
            },
            {
                un: "1993",
                name_ar: "سوائل قابلة للاشتعال، غير محددة باسم آخر (N.O.S)",
                name_en: "Flammable Liquids, N.O.S.",
                hazard_class: "3",
                subrisk: "سائل قابل للاشتعال عام",
                subrisk_en: "General Flammable Liquid",
                packing_group: "I / II / III",
                ems: "F-E, S-E",
                precautions_ar: "قد تكون الأبخرة أثقل من الهواء وتنتشر على الأرض لمسافات. يجب تأريض جميع المعدات والتأكد من غياب الشرر.",
                precautions_en: "Vapors may form explosive mixtures with air. Vapors may travel to source of ignition and flash back. Ground containers.",
                firstaid_ar: " نقل المصاب للهواء النقي. غسل الجلد بالماء والصابون. في حالة ملع المادة: تقديم عناية طبية فورية وعدم تحفيز التقيؤ.",
                firstaid_en: "Move victim to fresh air. Wash skin with soap and water. If swallowed, seek immediate medical attention. Do NOT induce vomiting.",
                ppe_ar: "نظارات حماية، قفازات مقاومات للمذيبات العضوية، ملابس قطنية مضادة للكهرباء الساكنة.",
                ppe_en: "Safety goggles, solvent-resistant gloves, anti-static cotton work clothing.",
                spill_ar: "إبعاد كل مصادر الشرر. امتصاص السائل بمادة مضادة للاشتعال كVermiculite أو التراب الجاف."
            }
        ];

        // Active dataset (starts with default, updated via CSV/Excel upload)
        let hazmatDatabase = [...defaultHazmatData];
        let activeRecord = hazmatDatabase[0];

        // Initialize UI on window load
        window.onload = function() {
            renderPresetChips();
            renderHazmatList();
            displayRecord(hazmatDatabase[0]);
            updateLanguageUI();
        };

        // Render Quick Selection Chips
        function renderPresetChips() {
            const container = document.getElementById('preset-chips');
            container.innerHTML = '';
            
            hazmatDatabase.slice(0, 6).forEach(item => {
                const chip = document.createElement('button');
                chip.className = "px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-sky-600/30 hover:border-sky-500/50 text-xs text-slate-300 border border-slate-700 transition font-mono flex items-center gap-1.5";
                chip.onclick = () => selectRecordByUN(item.un);
                chip.innerHTML = `<span class="text-sky-400 font-bold">UN ${item.un}</span> <span>${currentLang === 'ar' ? item.name_ar : item.name_en}</span>`;
                container.appendChild(chip);
            });
        }

        // Render Database Records in Right Sidebar
        function renderHazmatList(filteredData = null) {
            const listContainer = document.getElementById('hazmat-list');
            const dataToRender = filteredData || hazmatDatabase;
            
            document.getElementById('records-count').textContent = `${dataToRender.length} ${currentLang === 'ar' ? 'مواد' : 'items'}`;
            listContainer.innerHTML = '';

            if (dataToRender.length === 0) {
                listContainer.innerHTML = `
                    <div class="p-6 text-center text-slate-500 text-xs">
                        <i class="fa-solid fa-folder-open text-2xl mb-2 block"></i>
                        ${currentLang === 'ar' ? 'لم يتم العثور على نتائج مطابقة' : 'No matching records found'}
                    </div>
                `;
                return;
            }

            dataToRender.forEach(item => {
                const isSelected = activeRecord && activeRecord.un === item.un;
                const card = document.createElement('div');
                card.className = `p-3 rounded-xl border transition cursor-pointer flex items-start justify-between gap-2 ${
                    isSelected 
                    ? 'bg-sky-950/40 border-sky-500 shadow-md shadow-sky-500/10' 
                    : 'bg-slate-950/50 border-slate-800 hover:border-slate-700 hover:bg-slate-800/40'
                }`;
                card.onclick = () => displayRecord(item);

                card.innerHTML = `
                    <div class="space-y-0.5">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-xs font-black text-sky-400 bg-sky-950 px-1.5 py-0.5 rounded border border-sky-800/50">
                                UN ${item.un}
                            </span>
                            <span class="text-xs font-semibold text-slate-200 line-clamp-1">
                                ${currentLang === 'ar' ? item.name_ar : item.name_en}
                            </span>
                        </div>
                        <p class="text-[11px] text-slate-400 line-clamp-1">
                            ${currentLang === 'ar' ? (item.subrisk || '') : (item.subrisk_en || '')}
                        </p>
                    </div>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300 border border-slate-700 whitespace-nowrap">
                        Cl. ${item.hazard_class}
                    </span>
                `;
                listContainer.appendChild(card);
            });
        }

        // Display Selected Record in Detailed Card
        function displayRecord(record) {
            if (!record) return;
            activeRecord = record;

            document.getElementById('card-un').textContent = `UN ${record.un}`;
            document.getElementById('card-class-badge').textContent = `${currentLang === 'ar' ? 'فئة الخطر' : 'Class'} ${record.hazard_class}`;
            
            // Name & Sub-risk
            document.getElementById('card-name').textContent = currentLang === 'ar' ? (record.name_ar || record.name_en) : (record.name_en || record.name_ar);
            document.getElementById('card-subrisk').textContent = currentLang === 'ar' ? (record.subrisk || record.subrisk_en || '') : (record.subrisk_en || record.subrisk || '');

            // Sections
            document.getElementById('card-precautions').textContent = currentLang === 'ar' ? (record.precautions_ar || record.precautions_en) : (record.precautions_en || record.precautions_ar);
            document.getElementById('card-firstaid').textContent = currentLang === 'ar' ? (record.firstaid_ar || record.firstaid_en) : (record.firstaid_en || record.firstaid_ar);
            document.getElementById('card-ppe').textContent = currentLang === 'ar' ? (record.ppe_ar || record.ppe_en) : (record.ppe_en || record.ppe_ar);
            document.getElementById('card-spill').textContent = currentLang === 'ar' ? (record.spill_ar || record.spill_en || record.precautions_ar) : (record.spill_en || record.spill_ar || record.precautions_en);

            // Technical details
            document.getElementById('card-pg').textContent = record.packing_group || 'N/A';
            document.getElementById('card-ems').textContent = record.ems || 'N/A';

            // Re-render list to highlight active item
            renderHazmatList();
        }

        // Handle Real-time Search Input
        function handleSearch() {
            const query = document.getElementById('search-input').value.trim().toLowerCase();
            const clearBtn = document.getElementById('clear-btn');

            if (query.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
                renderHazmatList();
                return;
            }

            const results = hazmatDatabase.filter(item => {
                const unMatch = item.un.toLowerCase().includes(query);
                const nameArMatch = item.name_ar && item.name_ar.toLowerCase().includes(query);
                const nameEnMatch = item.name_en && item.name_en.toLowerCase().includes(query);
                const classMatch = item.hazard_class && item.hazard_class.toLowerCase().includes(query);
                return unMatch || nameArMatch || nameEnMatch || classMatch;
            });

            renderHazmatList(results);

            // Automatically select first match if found
            if (results.length > 0) {
                displayRecord(results[0]);
            }
        }

        function executeSearch() {
            handleSearch();
        }

        function clearSearch() {
            document.getElementById('search-input').value = '';
            document.getElementById('clear-btn').classList.add('hidden');
            renderHazmatList();
            if (hazmatDatabase.length > 0) {
                displayRecord(hazmatDatabase[0]);
            }
        }

        function selectRecordByUN(unCode) {
            const item = hazmatDatabase.find(r => r.un === unCode);
            if (item) {
                document.getElementById('search-input').value = unCode;
                document.getElementById('clear-btn').classList.remove('hidden');
                displayRecord(item);
            }
        }

        // Handle Excel / CSV File Upload
        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const fileName = file.name.toLowerCase();

            if (fileName.endsWith('.csv')) {
                Papa.parse(file, {
                    header: true,
                    skipEmptyLines: true,
                    complete: function(results) {
                        processUploadedRows(results.data);
                    }
                });
            } else if (fileName.endsWith('.xlsx') || fileName.endsWith('.xls')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, {type: 'array'});
                    const firstSheet = workbook.SheetNames[0];
                    const jsonData = XLSX.utils.sheet_to_json(workbook.Sheets[firstSheet]);
                    processUploadedRows(jsonData);
                };
                reader.readAsArrayBuffer(file);
            }
        }

        // Process imported spreadsheet rows into internal standard format
        function processUploadedRows(rows) {
            if (!rows || rows.length === 0) {
                alert(currentLang === 'ar' ? 'الملف فارغ أو غير متوافق!' : 'Uploaded file is empty or invalid!');
                return;
            }

            const parsedRecords = rows.map((row, index) => {
                // Flexible keys check
                return {
                    un: String(row.UN || row.un || row['UN Number'] || row['رقم_الأمم_المتحدة'] || (1000 + index)),
                    name_ar: row.Name_AR || row.name_ar || row['الاسم_بالعربي'] || row.Name || row.name || "مادة غير معرفة",
                    name_en: row.Name_EN || row.name_en || row['الاسم_بالإنجليزي'] || row.Name || row.name || "Chemical Substance",
                    hazard_class: String(row.Class || row.hazard_class || row['فئة_الخطر'] || "9"),
                    subrisk: row.Subrisk_AR || row.subrisk || row['مخاطر_فرعية'] || "",
                    subrisk_en: row.Subrisk_EN || row.subrisk_en || "",
                    packing_group: row.PG || row.packing_group || row['مجموعة_التعبئة'] || "II",
                    ems: row.EmS || row.ems || "F-A, S-A",
                    precautions_ar: row.Precautions_AR || row.precautions_ar || row['الوقاية_والتفاعل'] || row.precautions || "اتبع إجراءات السلامة القياسية للمواد الخطرة.",
                    precautions_en: row.Precautions_EN || row.precautions_en || "Follow standard hazmat safety protocols.",
                    firstaid_ar: row.FirstAid_AR || row.firstaid_ar || row['الإسعافات_الأولية'] || row.firstaid || "اتصل بالطوارئ فوراً واغسل المكان المتأثر بالماء.",
                    firstaid_en: row.FirstAid_EN || row.firstaid_en || "Seek medical help immediately. Wash affected area.",
                    ppe_ar: row.PPE_AR || row.ppe_ar || row['معدات_الوقاية'] || row.ppe || "قفازات كيميائية، نظارات سلامة، وجهاز تنفس.",
                    ppe_en: row.PPE_EN || row.ppe_en || "Chemical gloves, goggles, respirator.",
                    spill_ar: row.Spill_AR || row.spill_ar || row['التسرب'] || row.spill || "اعزل المنطقة وقم باحتواء السائل بالرمل.",
                    spill_en: row.Spill_EN || row.spill_en || "Isolate area and absorb with sand."
                };
            });

            hazmatDatabase = parsedRecords;
            renderPresetChips();
            renderHazmatList();
            displayRecord(hazmatDatabase[0]);

            alert(currentLang === 'ar' 
                ? `تم استيراد ${parsedRecords.length} مادة خطرة بنجاح!` 
                : `Successfully imported ${parsedRecords.length} records!`);
        }

        // Reset to initial built-in dataset
        function resetToDefaultData() {
            hazmatDatabase = [...defaultHazmatData];
            renderPresetChips();
            renderHazmatList();
            displayRecord(hazmatDatabase[0]);
            clearSearch();
        }

        // Export active single record to CSV
        function exportCurrentToCSV() {
            if (!activeRecord) return;
            const data = [activeRecord];
            downloadCSV(data, `Hazmat_UN${activeRecord.un}_Safety_Card.csv`);
        }

        // Export entire dataset to CSV
        function exportAllToCSV() {
            downloadCSV(hazmatDatabase, `Full_IMDG_Hazmat_Database.csv`);
        }

        // CSV Download Helper
        function downloadCSV(dataArray, filename) {
            const csv = Papa.unparse(dataArray);
            const blob = new Blob(["\ufeff" + csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", filename);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // Toggle Language (Arabic / English)
        function toggleLanguage() {
            currentLang = currentLang === 'ar' ? 'en' : 'ar';
            document.documentElement.dir = currentLang === 'ar' ? 'rtl' : 'ltr';
            document.documentElement.lang = currentLang;

            updateLanguageUI();
            renderPresetChips();
            renderHazmatList();
            if (activeRecord) {
                displayRecord(activeRecord);
            }
        }

        // Update Static Text Elements according to language
        function updateLanguageUI() {
            const isAr = currentLang === 'ar';

            document.getElementById('lang-btn-text').textContent = isAr ? 'English' : 'عربي';
            document.getElementById('txt-app-title').textContent = isAr ? 'دليل المواد الخطرة (IMDG Code / UN)' : 'IMDG Hazmat & Safety Emergency Dashboard';
            document.getElementById('txt-app-subtitle').textContent = isAr ? 'نظام الطوارئ والوقاية والاستجابة للحوادث البحرية' : 'International Maritime Dangerous Goods Response System';
            document.getElementById('txt-upload-btn').textContent = isAr ? 'استيراد شيت (Excel/CSV)' : 'Import File (Excel/CSV)';
            
            document.getElementById('lbl-search').textContent = isAr ? 'ابحث برقم الأمم المتحدة (UN Number) أو اسم المادة الكيميائية:' : 'Search by UN Number or Chemical Name:';
            document.getElementById('search-input').placeholder = isAr ? 'مثال: 1203, 1230, Gasoline, Methanol...' : 'e.g., 1203, 1230, Gasoline, Methanol...';
            document.getElementById('btn-search-text').textContent = isAr ? 'بحث مفصل' : 'Search';
            document.getElementById('txt-quick-search').textContent = isAr ? 'بحث سريع:' : 'Quick Select:';

            document.getElementById('hdr-precautions').textContent = isAr ? 'طرق التفاعل والوقاية من الحريق' : 'Reactivity & Fire Precautions';
            document.getElementById('hdr-firstaid').textContent = isAr ? 'الإسعافات الأولية وطريقة التعامل مع الإصابات' : 'First Aid & Injury Management';
            document.getElementById('hdr-ppe').textContent = isAr ? 'معدات الوقاية الشخصية المطلوب ارتداؤها (PPE)' : 'Personal Protective Equipment (PPE)';
            document.getElementById('hdr-spill').textContent = isAr ? 'طريقة التعامل مع تسرب المادة (Spill Handling)' : 'Emergency Spill & Leak Handling';

            document.getElementById('lbl-pg').textContent = isAr ? 'مجموعة التعبئة (Packing Group):' : 'Packing Group (PG):';
            document.getElementById('lbl-emg-guide').textContent = isAr ? 'دليل الطوارئ (EmS/ERG):' : 'Emergency Guide (EmS):';

            document.getElementById('txt-records-title').textContent = isAr ? 'جدول المواد المتاحة' : 'Available Substances';
            document.getElementById('btn-export-all').textContent = isAr ? 'تصدير جميع البيانات لملف CSV' : 'Export Full Database to CSV';
            document.getElementById('txt-footer').textContent = isAr ? 'نظام معايير السلامة والاستجابة للطوارئ البحرية - كود البضائع الخطرة IMDG' : 'Maritime Safety Standards & Emergency Response System - IMDG Code';
        }
    </script>
