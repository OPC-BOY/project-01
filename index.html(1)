<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMDG Hazmat & UN Number Safety Dashboard</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                            800: '#0c4a6e',
                            900: '#0f172a',
                        },
                        hazard: {
                            explosive: '#ef4444',
                            flammable: '#f97316',
                            toxic: '#8b5cf6',
                            corrosive: '#ec4899',
                            gas: '#3b82f6',
                            misc: '#64748b'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'Segoe UI', 'Tahoma', 'Geneva', 'Verdana', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome & Lucide Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- PapaParse for CSV Upload -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
    <!-- SheetJS for Excel files -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
        
        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background: white !important;
                color: black !important;
            }
            .print-card {
                border: 1px solid #ccc !important;
                box-shadow: none !important;
                color: black !important;
                background: white !important;
            }
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans antialiased flex flex-col selection:bg-sky-500 selection:text-white">

    <!-- Top Navigation Header -->
    <header class="bg-slate-900/80 backdrop-blur border-b border-slate-800 sticky top-0 z-50 no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-4">
            
            <!-- Logo & Title -->
            <div class="flex items-center space-x-3 space-x-reverse">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-600 to-indigo-600 flex items-center justify-center shadow-lg shadow-sky-500/20">
                    <i class="fa-solid font-bold fa-triangle-exclamation text-white text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold bg-gradient-to-r from-white via-slate-200 to-slate-400 bg-clip-text text-transparent">
                        <span id="txt-app-title">دليل المواد الخطرة (IMDG Code / UN)</span>
                    </h1>
                    <p class="text-xs text-slate-400" id="txt-app-subtitle">نظام الطوارئ والوقاية والاستجابة للحوادث البحرية</p>
                </div>
            </div>

            <!-- Header Controls & Actions -->
            <div class="flex items-center gap-3">
                <!-- Language Toggle -->
                <button onclick="toggleLanguage()" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 transition border border-slate-700">
                    <i class="fa-solid fa-globe text-sky-400"></i>
                    <span id="lang-btn-text">English</span>
                </button>

                <!-- Data File Import Button -->
                <label class="cursor-pointer flex items-center gap-2 px-3 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold transition shadow-md shadow-sky-600/20">
                    <i class="fa-solid fa-file-excel"></i>
                    <span id="txt-upload-btn">استيراد شيت (Excel/CSV)</span>
                    <input type="file" id="excel-file-input" accept=".csv, .xlsx, .xls" class="hidden" onchange="handleFileUpload(event)">
                </label>

                <!-- Reset Dataset -->
                <button onclick="resetToDefaultData()" title="استعادة البيانات الافتراضية" class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition border border-slate-700">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- Search Bar Section -->
        <section class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-6 shadow-xl relative overflow-hidden no-print">
            <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
            
            <label id="lbl-search" class="block text-sm font-semibold text-slate-300 mb-2">ابحث برقم الأمم المتحدة (UN Number) أو اسم المادة الكيميائية:</label>
            
            <div class="flex flex-col sm:flex-row gap-3">
                <div class="relative flex-grow">
                    <div class="absolute inset-y-0 start-0 flex items-center ps-4 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass text-lg"></i>
                    </div>
                    <input type="text" id="search-input" oninput="handleSearch()" placeholder="مثال: 1203, 1230, Gasoline, Methanol..." 
                           class="w-full ps-11 pe-4 py-3 bg-slate-950 border border-slate-700 rounded-xl focus:ring-2 focus:ring-sky-500 focus:border-transparent text-slate-100 placeholder-slate-500 text-base transition outline-none">
                    <button onclick="clearSearch()" id="clear-btn" class="hidden absolute inset-y-0 end-0 flex items-center pe-4 text-slate-400 hover:text-white">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>
                
                <button onclick="executeSearch()" class="px-6 py-3 bg-gradient-to-r from-sky-600 to-indigo-600 hover:from-sky-500 hover:to-indigo-500 text-white font-semibold rounded-xl shadow-lg shadow-sky-600/25 transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-search"></i>
                    <span id="btn-search-text">بحث مفصل</span>
                </button>
            </div>

            <!-- Quick Preset Chips -->
            <div class="mt-4 flex items-center gap-2 flex-wrap">
                <span class="text-xs text-slate-400 font-medium" id="txt-quick-search">بحث سريع:</span>
                <div class="flex flex-wrap gap-1.5" id="preset-chips">
                    <!-- Dynamic chips populated via JS -->
                </div>
            </div>
        </section>

        <!-- Main Display Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Left Panel: Search Results Details (8 cols) -->
            <div class="lg:col-span-8 space-y-6">
                
                <!-- Active Hazmat Card -->
                <div id="hazmat-card" class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl relative print-card">
                    
                    <!-- Top Badge & Actions -->
                    <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-800 pb-5">
                        <div>
                            <div class="flex items-center gap-3 mb-2">
                                <span id="card-un" class="px-3 py-1 rounded-md bg-sky-500/20 text-sky-400 font-mono text-xl font-black border border-sky-500/30">
                                    UN ----
                                </span>
                                <span id="card-class-badge" class="px-3 py-1 rounded-md bg-orange-500/20 text-orange-400 text-xs font-bold border border-orange-500/30">
                                    Class -
                                </span>
                            </div>
                            <h2 id="card-name" class="text-2xl font-black text-white tracking-wide">اختر أو ابحث عن مادة خطرة</h2>
                            <p id="card-subrisk" class="text-sm text-slate-400 mt-1">المخاطر الفرعية / مجموعات التعبئة والتغليف</p>
                        </div>

                        <!-- Print & Quick Actions -->
                        <div class="flex items-center gap-2 no-print">
                            <button onclick="window.print()" title="طباعة البطاقة" class="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition border border-slate-700">
                                <i class="fa-solid fa-print"></i>
                            </button>
                            <button onclick="exportCurrentToCSV()" title="تصدير كـ CSV" class="p-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition border border-slate-700">
                                <i class="fa-solid fa-file-csv"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Detailed Content Sections Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-6">
                        
                        <!-- 1. Hazards & Precautions (طرق التفاعل والوقاية) -->
                        <div class="bg-slate-950/60 border border-slate-800/80 rounded-xl p-4 space-y-2">
                            <div class="flex items-center gap-2 text-amber-400 font-bold text-sm">
                                <i class="fa-solid fa-shield-halved text-base"></i>
                                <span id="hdr-precautions">طرق التفاعل والوقاية من الحريق</span>
                            </div>
                            <p id="card-precautions" class="text-xs text-slate-300 leading-relaxed min-h-[60px]">
                                اختر مادة كيميائية لعرض معلومات الوقاية وتدابير السلامة الخاصة بها.
                            </p>
                        </div>

                        <!-- 2. First Aid & Injuries (التعامل مع الإصابات) -->
                        <div class="bg-slate-950/60 border border-slate-800/80 rounded-xl p-4 space-y-2">
                            <div class="flex items-center gap-2 text-rose-400 font-bold text-sm">
                                <i class="fa-solid fa-user-nurse text-base"></i>
                                <span id="hdr-firstaid">الإسعافات الأولية وطريقة التعامل مع الإصابات</span>
                            </div>
                            <p id="card-firstaid" class="text-xs text-slate-300 leading-relaxed min-h-[60px]">
                                سيتم عرض الإجراءات الفورية اللازمة لإسعاف المصابين عند التعرض أو الاستنشاق أو الملامسة.
                            </p>
                        </div>

                        <!-- 3. PPE / Protective Equipment (معدات الوقاية الشخصية) -->
                        <div class="bg-slate-950/60 border border-slate-800/80 rounded-xl p-4 space-y-2">
                            <div class="flex items-center gap-2 text-sky-400 font-bold text-sm">
                                <i class="fa-solid fa-mask-ventilator text-base"></i>
                                <span id="hdr-ppe">معدات الوقاية الشخصية المطلوب ارتداؤها (PPE)</span>
                            </div>
                            <p id="card-ppe" class="text-xs text-slate-300 leading-relaxed min-h-[60px]">
                                معدات الحماية الموصى بها لمناولة الشحنة والتجول بالقرب منها.
                            </p>
                        </div>

                        <!-- 4. Emergency Spill / Leak (طريقة التعامل مع التسرب والانسكاب) -->
                        <div class="bg-slate-950/60 border border-slate-800/80 rounded-xl p-4 space-y-2">
                            <div class="flex items-center gap-2 text-emerald-400 font-bold text-sm">
                                <i class="fa-solid fa-biohazard text-base"></i>
                                <span id="hdr-spill">طريقة التعامل مع تسرب المادة (Spill Handling)</span>
                            </div>
                            <p id="card-spill" class="text-xs text-slate-300 leading-relaxed min-h-[60px]">
                                خطوات العزل والاحتواء وإخلاء المكان أثناء حالات التسرب أو الانسكاب البحري/البري.
                            </p>
                        </div>

                    </div>

                    <!-- IMDG Technical Details Footer Bar -->
                    <div class="mt-6 pt-4 border-t border-slate-800 flex flex-wrap items-center justify-between text-xs text-slate-400 gap-4">
                        <div class="flex items-center gap-4">
                            <span><strong id="lbl-pg">مجموعة التعبئة (Packing Group):</strong> <span id="card-pg" class="text-slate-200">--</span></span>
                            <span><strong id="lbl-emg-guide">دليل الطوارئ (EmS/ERG):</strong> <span id="card-ems" class="text-slate-200">--</span></span>
                        </div>
                        <div class="text-slate-500 font-mono text-[11px]">
                            IMDG Code Code / Solas Verified
                        </div>
                    </div>

                </div>

            </div>

            <!-- Right Panel: Full Hazmat Database / Table View (4 cols / full on mobile) -->
            <div class="lg:col-span-4 space-y-4 no-print">
                
                <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl space-y-3">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-800">
                        <div class="flex items-center gap-2 font-bold text-sm text-slate-200">
                            <i class="fa-solid fa-database text-sky-400"></i>
                            <span id="txt-records-title">جدول المواد المتاحة</span>
                        </div>
                        <span id="records-count" class="px-2 py-0.5 rounded-full bg-slate-800 text-xs font-mono text-slate-400">
                            0 مواد
                        </span>
                    </div>

                    <!-- Scrollable List of Materials -->
                    <div id="hazmat-list" class="space-y-2 max-h-[520px] overflow-y-auto pe-1">
                        <!-- Populated dynamically via JS -->
                    </div>

                    <!-- Export Dataset Action -->
                    <button onclick="exportAllToCSV()" class="w-full py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white rounded-xl text-xs font-semibold transition border border-slate-700 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-download"></i>
                        <span id="btn-export-all">تصدير جميع البيانات لملف CSV</span>
                    </button>
                </div>

            </div>

        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 border-t border-slate-800 py-4 mt-8 no-print text-center text-xs text-slate-500">
        <div class="max-w-7xl mx-auto px-4">
            <p id="txt-footer">نظام معايير السلامة والاستجابة للطوارئ البحرية - كود البضائع الخطرة IMDG</p>
        </div>
    </footer>

